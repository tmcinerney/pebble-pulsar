{
  "name": "pebble-pulsar-suite",
  "author": "Travers McInerney",
  "description": "Hamilton Pulsar 1970s Time Computer Suite for Pebble OS — Watchface, Chronograph, Countdown Timer, and Alarm.",
  "version": "2.2.0",
  "private": true,
  "scripts": {
    "build": "python3 scripts/build_all.py",
    "build:watchface": "cd apps/watchface && pebble build",
    "build:chrono": "cd apps/chrono && pebble build",
    "build:timer": "cd apps/timer && pebble build",
    "build:alarm": "cd apps/alarm && pebble build",
    "test": "python3 tests/test_firmware.py",
    "validate:pbw": "python3 scripts/validate_pbw.py",
    "assets:watchface": "python3 scripts/generate_app_assets.py watchface",
    "assets:chrono": "python3 scripts/generate_app_assets.py chrono",
    "assets:timer": "python3 scripts/generate_app_assets.py timer",
    "assets:alarm": "python3 scripts/generate_app_assets.py alarm",
    "assets:all": "python3 scripts/generate_app_assets.py all",
    "store-assets": "python3 scripts/generate_store_assets.py"
  }
}
